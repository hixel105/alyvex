# Alyvex Community - Environment Variables

# Supabase (pre-configured automatically)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Owner authentication (server-side, edge function secrets)
# The OWNER_PASSWORD is used by the edge function to validate login.
# Default is "vsebasowner" if not set.
OWNER_PASSWORD=vsebasowner

# Session secret for HMAC token signing (edge function).
# If not set, falls back to the Supabase service role key.
SESSION_SECRET=
